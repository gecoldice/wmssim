{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://warehouse-sim.local/schemas/v0.3/common.json",
  "title": "simapp contract common defs v0.3",
  "description": "外层契约共用定义。contractVersion=0.3。平面米制 X 东 Y 北；null=未知；0=确认零值。",
  "$defs": {
    "ContractVersion": {
      "const": "0.3"
    },
    "Id": {
      "type": "string",
      "minLength": 1
    },
    "RevisionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "revision": { "$ref": "#/$defs/Id" }
      }
    },
    "Point2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "description": "米，东" },
        "y": { "type": "number", "description": "米，北" }
      }
    },
    "Polygon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outer"],
      "properties": {
        "outer": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/Point2" }
        },
        "holes": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 3,
            "items": { "$ref": "#/$defs/Point2" }
          }
        }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKind", "confirmationStatus", "updatedAt"],
      "properties": {
        "sourceKind": {
          "type": "string",
          "enum": ["manual", "drawing", "inferred", "catalog", "measured", "demo"]
        },
        "sourceRef": { "type": ["string", "null"] },
        "confirmationStatus": {
          "type": "string",
          "enum": ["pending", "confirmed", "rejected"]
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INPUT_UNCONFIRMED",
            "UNSUPPORTED_SCENARIO",
            "GEOMETRY_INVALID",
            "LOCK_CONFLICT",
            "NO_ACCESS_NODE",
            "ROUTE_UNREACHABLE",
            "REVISION_CONFLICT",
            "STALE_VALIDATION",
            "NOT_SIMULATION_READY",
            "LAYOUT_REVISION_MISMATCH",
            "ELEMENT_ID",
            "NO_RESOURCES",
            "NARROW_AISLE",
            "INCOMPARABLE_RESULTS",
            "PRICE_INCOMPLETE",
            "SCORE_PROFILE_INVALID",
            "COMPUTATION_FAILED"
          ]
        },
        "message": { "type": "string" },
        "details": { "type": ["object", "null"], "additionalProperties": true },
        "retryable": { "type": "boolean" },
        "traceId": { "type": ["string", "null"] }
      }
    },
    "JobState": {
      "type": "string",
      "enum": ["queued", "running", "cancel_requested", "succeeded", "failed", "cancelled"]
    },
    "SearchBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxConfigurations", "maxIterations", "maxWallTimeSec", "maxMemoryMb"],
      "properties": {
        "maxConfigurations": { "type": "integer", "exclusiveMinimum": 0 },
        "maxIterations": { "type": "integer", "exclusiveMinimum": 0 },
        "maxWallTimeSec": { "type": "number", "exclusiveMinimum": 0 },
        "maxMemoryMb": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "Lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instanceId", "fields"],
      "properties": {
        "instanceId": { "$ref": "#/$defs/Id" },
        "fields": {
          "oneOf": [
            { "const": "all" },
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          ]
        }
      }
    },
    "MetricValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricId", "unit", "method", "status", "computedAt"],
      "properties": {
        "metricId": { "type": "string", "minLength": 1 },
        "value": { "type": ["number", "null"] },
        "unit": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["ok", "unknown", "not_applicable", "incomplete", "error"]
        },
        "reasonCode": { "type": ["string", "null"] },
        "inputFingerprint": { "type": ["string", "null"] },
        "sourceRefs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "computedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
