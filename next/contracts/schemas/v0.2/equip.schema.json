{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://warehouse-sim.local/schemas/equip-v0.2.json",
  "title": "Warehouse Sim equip.json schema v0.2",
  "description": "接口契约 v0.2（patch v0.2.1）。字段对齐元素库 v0.1.2。element_id 只认元素库正式 ID（大类-子类[-细分]-两位序号，如 ST-PAL-01、PK-DEPAL-BUF-01）；禁止历史短名 alias（in_dock、st_pal_std 等）。v0.2.1：glb 改为可选（允许空串）；新增可选 visual.proxy（\"box\"|\"none\"）以支持无 GLB 盒子代理；P1 拟增 visual.drag_ghost / snap_points / runtime_bindings（见 p1-visual-schema-proposal-v0.2.md，本轮非必填）。坐标系：Y-up、XZ 地平面；orientation_deg：0°→+Z，绕+Y 逆时针。单位：米(_m)、度(_deg)、千克(_kg)、吞吐 *_per_hour / throughput_uph。禁止平行字段 yaw / takt_s / in_ports / out_ports。accessNodeId 属布局实例/货位，不进本 schema。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "element_id",
    "element_type",
    "display_name",
    "lod",
    "footprint",
    "colliders",
    "ports",
    "connector_ids",
    "params"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2",
      "description": "契约版本，固定为字符串 0.2"
    },
    "element_id": {
      "type": "string",
      "pattern": "^[A-Z]+(-[A-Z]+)+-[0-9]{2}$",
      "description": "元素库正式 ID，格式 CAT-SUB[-SUB…]-NN（如 ST-PAL-01、PK-DEPAL-BUF-01、CV-INDUCT-EACH-01）。禁止短名 alias（in_dock、st_pal_std、aisle_seg 等）。",
      "examples": [
        "IN-DOCK-01",
        "ST-PAL-01",
        "PK-DEPAL-01",
        "OUT-FULL-01",
        "MH-HAND-01",
        "AUX-FIRE-01"
      ]
    },
    "element_type": {
      "$ref": "#/$defs/ElementType"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "glb": {
      "type": "string",
      "description": "主 GLB 路径（相对资产包根或绝对 URL）。v0.2.1 起可选；无网格时用空串并设 visual.proxy=\"box\"。"
    },
    "lod": {
      "$ref": "#/$defs/LodMap"
    },
    "footprint": {
      "$ref": "#/$defs/Footprint"
    },
    "colliders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Collider"
      },
      "description": "3D 碰撞体；缺省时运行时用 footprint×高度生成 OBB"
    },
    "ports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Port"
      },
      "description": "几何端口；每个 ports[].id 必须属于 connector_ids"
    },
    "connector_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "元素库对外逻辑连接引用；ports[].id ⊆ connector_ids"
    },
    "params": {
      "$ref": "#/$defs/ParamsRoot"
    },
    "soft_margin": {
      "type": "object",
      "additionalProperties": false,
      "description": "可选软边距（米），用于吸附与通道提示，非硬碰撞",
      "properties": {
        "front_m": {
          "type": "number",
          "minimum": 0
        },
        "back_m": {
          "type": "number",
          "minimum": 0
        },
        "left_m": {
          "type": "number",
          "minimum": 0
        },
        "right_m": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "meta": {
      "type": "object",
      "description": "可选元数据：作者、修订、元素库对照 ID 等",
      "additionalProperties": true,
      "properties": {
        "element_library_id": {
          "type": "string",
          "description": "对照元素库 ID，如 ST-PAL-01"
        },
        "flows": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pallet_full",
              "decant",
              "small_sort"
            ]
          },
          "description": "样例综合仓流：整托 / 拆托 / 小件分拣"
        },
        "notes": {
          "type": "string"
        },
        "proxy": {
          "type": "boolean",
          "description": "兼容标注；权威以 visual.proxy 为准"
        }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "description": "视觉与代理。v0.2.1：proxy。P1 拟增 drag_ghost（见提案 md，本轮不强制校验子字段）。",
      "properties": {
        "proxy": {
          "type": "string",
          "enum": [
            "box",
            "none"
          ],
          "description": "无 GLB 时用 footprint×高度半透明盒子；真 GLB 到位后 none 或缺省"
        },
        "ghost_color": {
          "type": "string",
          "description": "可选代理/幽灵色（CSS 色或 #RRGGBB）"
        },
        "drag_ghost": {
          "type": "object",
          "description": "P1 拟增：拖拽幽灵（必须进 equip；本轮可选不校验细项）。最小：enabled, opacity(0.35–0.5), use_lod, show_footprint, show_clearance",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "opacity": {
              "type": "number",
              "minimum": 0.35,
              "maximum": 0.5
            },
            "use_lod": {
              "type": "string"
            },
            "show_footprint": {
              "type": "boolean"
            },
            "show_clearance": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "snap_points": {
      "type": "array",
      "description": "P1 拟增：模板级吸附点，与 ports 同局部坐标系；布局柱网/巷道规则吸附勿进。本轮非必填。",
      "items": {
        "$ref": "#/$defs/SnapPoint"
      }
    },
    "runtime_bindings": {
      "type": "object",
      "description": "P1 拟增：默认/角色运行时绑定；实例 pose/轨迹/镜头/分区色勿进。本轮非必填。",
      "additionalProperties": true,
      "properties": {
        "on_place_visible": {
          "type": "boolean"
        },
        "simulation_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "static",
              "agent",
              "cargo"
            ]
          }
        },
        "path_layer": {
          "type": "string",
          "enum": [
            "none",
            "pedestrian",
            "vehicle",
            "agv",
            "cargo"
          ]
        },
        "trail_style": {},
        "animation": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "path_follower": {
              "type": "boolean"
            },
            "anim_clips": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "ElementType": {
      "type": "string",
      "enum": [
        "Dock",
        "PalletRack",
        "FloorStack",
        "PickStation",
        "PackStation",
        "StagingBuffer",
        "StagingShip",
        "AisleSegment",
        "ConveyorStraight",
        "ConveyorDivert",
        "DecantStation",
        "Putwall",
        "SeedStation",
        "SorterStation",
        "Generic"
      ]
    },
    "LodMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lod1"
      ],
      "description": "lod0/lod1/lod2：GLB 内节点名或以 assets/ 开头的独立文件路径；代理阶段 lod1 可写 proxy:box，真 GLB 到位后替换",
      "properties": {
        "lod0": {
          "type": "string",
          "minLength": 1
        },
        "lod1": {
          "type": "string",
          "minLength": 1
        },
        "lod2": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Vec2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "[x_m, z_m] 地平面点"
    },
    "Footprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "clearance_h_m"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "aabb",
            "polygon"
          ]
        },
        "clearance_h_m": {
          "type": "number",
          "minimum": 0,
          "description": "净空高度（米），用于叉车/人机净高校验"
        },
        "aabb": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "length_m",
            "width_m"
          ],
          "properties": {
            "length_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "width_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "offset_x_m": {
              "type": "number",
              "default": 0
            },
            "offset_z_m": {
              "type": "number",
              "default": 0
            }
          }
        },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/Vec2"
          },
          "description": "XZ 平面多边形顶点，局部坐标，逆时针"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "aabb"
            }
          },
          "required": [
            "aabb"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "polygon"
            }
          },
          "required": [
            "polygon"
          ]
        }
      ]
    },
    "Collider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "obb",
            "aabb",
            "capsule"
          ]
        },
        "x_m": {
          "type": "number",
          "default": 0
        },
        "y_m": {
          "type": "number",
          "default": 0
        },
        "z_m": {
          "type": "number",
          "default": 0
        },
        "length_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "orientation_deg": {
          "type": "number",
          "description": "相对设备局部：0°→局部 +Z，绕 +Y 逆时针"
        },
        "radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "Port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "x_m",
        "y_m",
        "z_m",
        "normal_deg",
        "family"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "必须 ∈ connector_ids"
        },
        "role": {
          "type": "string",
          "enum": [
            "in",
            "out",
            "bidirectional"
          ]
        },
        "x_m": {
          "type": "number"
        },
        "y_m": {
          "type": "number"
        },
        "z_m": {
          "type": "number"
        },
        "normal_deg": {
          "type": "number",
          "description": "端口朝向：0°→局部 +Z，绕 +Y 逆时针"
        },
        "family": {
          "type": "string",
          "description": "对接族：pallet | tote | conveyor | vehicle | person | generic"
        }
      }
    },
    "ParamField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value",
        "category"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "value": {
          "type": [
            "number",
            "integer",
            "string",
            "boolean",
            "array",
            "object",
            "null"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "geometry",
            "capability",
            "rules",
            "interface"
          ]
        },
        "unit": {
          "type": "string"
        },
        "readonly": {
          "type": "boolean",
          "default": false
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ParamsGrouped": {
      "type": "object",
      "additionalProperties": false,
      "description": "按四类分组的参数对象（推荐）",
      "properties": {
        "geometry": {
          "type": "object",
          "additionalProperties": true
        },
        "capability": {
          "type": "object",
          "additionalProperties": true
        },
        "rules": {
          "type": "object",
          "additionalProperties": true
        },
        "interface": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "ParamsFlat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "description": "扁平字段列表，每项带 category",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ParamField"
          }
        }
      }
    },
    "ParamsRoot": {
      "description": "params 可用分组对象或 flat+category 列表；也可用类型 $defs 约束",
      "oneOf": [
        {
          "$ref": "#/$defs/ParamsGrouped"
        },
        {
          "$ref": "#/$defs/ParamsFlat"
        },
        {
          "$ref": "#/$defs/Dock"
        },
        {
          "$ref": "#/$defs/PalletRack"
        },
        {
          "$ref": "#/$defs/FloorStack"
        },
        {
          "$ref": "#/$defs/PickStation"
        },
        {
          "$ref": "#/$defs/PackStation"
        },
        {
          "$ref": "#/$defs/StagingBuffer"
        },
        {
          "$ref": "#/$defs/StagingShip"
        },
        {
          "$ref": "#/$defs/AisleSegment"
        },
        {
          "$ref": "#/$defs/ConveyorStraight"
        },
        {
          "$ref": "#/$defs/ConveyorDivert"
        },
        {
          "$ref": "#/$defs/DecantStation"
        },
        {
          "$ref": "#/$defs/Putwall"
        },
        {
          "$ref": "#/$defs/SeedStation"
        },
        {
          "$ref": "#/$defs/SorterStation"
        }
      ]
    },
    "GeomCommon": {
      "type": "object",
      "properties": {
        "orientation_deg": {
          "type": "number",
          "description": "0°→世界 +Z，绕 +Y 逆时针；禁止平行 yaw"
        }
      }
    },
    "Dock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry",
        "capability",
        "rules",
        "interface"
      ],
      "properties": {
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "length_m",
            "width_m",
            "dock_height_m",
            "approach_angle_deg",
            "door_count",
            "orientation_deg"
          ],
          "properties": {
            "length_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "width_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "dock_height_m": {
              "type": "number",
              "minimum": 0
            },
            "approach_angle_deg": {
              "type": "number"
            },
            "door_count": {
              "type": "integer",
              "minimum": 1
            },
            "orientation_deg": {
              "type": "number"
            },
            "height_m": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "capability": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "vehicles_per_hour": {
              "type": "number",
              "minimum": 0
            },
            "max_truck_length_m": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "open_hours": {
              "type": "string"
            },
            "allowed_vehicle_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "interface": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "queue_capacity": {
              "type": "integer",
              "minimum": 0
            },
            "failure_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "PalletRack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry",
        "capability",
        "rules",
        "interface"
      ],
      "properties": {
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bay_w_m",
            "bay_d_m",
            "levels",
            "level_height_m",
            "bays",
            "aisle_w_m",
            "orientation_deg"
          ],
          "properties": {
            "bay_w_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "bay_d_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "levels": {
              "type": "integer",
              "minimum": 1
            },
            "level_height_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "bays": {
              "type": "integer",
              "minimum": 1
            },
            "aisle_w_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "orientation_deg": {
              "type": "number"
            }
          }
        },
        "capability": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "load_per_level_kg": {
              "type": "number",
              "minimum": 0
            },
            "pallets_per_bay": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "abc_zone": {
              "type": "string"
            },
            "max_sku_per_bay": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "interface": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "location_prefix": {
              "type": "string"
            },
            "putaway_score": {
              "type": "number"
            }
          }
        }
      }
    },
    "FloorStack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry",
        "capability",
        "rules",
        "interface"
      ],
      "description": "地堆：主真相 length_m/width_m/max_stack_h_m；grid_* 可选，不得与边长双写真相",
      "properties": {
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "length_m",
            "width_m",
            "max_stack_h_m",
            "orientation_deg"
          ],
          "properties": {
            "length_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "width_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_stack_h_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "orientation_deg": {
              "type": "number"
            },
            "aisle_w_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "grid_rows": {
              "type": "integer",
              "minimum": 1
            },
            "grid_cols": {
              "type": "integer",
              "minimum": 1
            },
            "max_stack": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "capability": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "pallet_slots": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "block_stacking": {
              "type": "boolean"
            }
          }
        },
        "interface": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "zone_id": {
              "type": "string"
            }
          }
        }
      }
    },
    "PickStation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry",
        "capability",
        "rules",
        "interface"
      ],
      "properties": {
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "length_m",
            "width_m",
            "height_m",
            "orientation_deg"
          ],
          "properties": {
            "length_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "width_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "orientation_deg": {
              "type": "number"
            }
          }
        },
        "capability": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "picks_per_hour": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "batch_size": {
              "type": "integer",
              "minimum": 1
