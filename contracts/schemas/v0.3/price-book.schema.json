{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://warehouse-sim.local/schemas/v0.3/price-book.json",
  "title": "PriceBookRevision",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "id", "revision", "currency", "items"],
  "properties": {
    "contractVersion": { "const": "0.3" },
    "id": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "parentRef": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "revision"],
          "properties": {
            "id": { "type": "string" },
            "revision": { "type": "string" }
          }
        }
      ]
    },
    "currency": { "type": "string", "minLength": 3 },
    "demoOnly": { "type": "boolean" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skuKey", "status"],
        "properties": {
          "skuKey": { "type": "string", "minLength": 1 },
          "unitPrice": { "type": ["number", "null"] },
          "unit": { "type": "string" },
          "status": { "type": "string", "enum": ["available", "missing"] },
          "source": { "type": ["string", "null"] },
          "asOf": { "type": ["string", "null"] },
          "taxInclusive": { "type": ["boolean", "null"] },
          "specNote": { "type": ["string", "null"] }
        }
      }
    }
  }
}
