{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://warehouse-sim.local/schemas/v0.3/planning-request.json",
  "title": "PlanningRequest v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "projectId",
    "facilityRef",
    "baseVariantRef",
    "demandRef",
    "scope",
    "locks",
    "goals",
    "constraints",
    "evaluationLevel",
    "budget",
    "seed",
    "catalogRef",
    "templateSetRef",
    "ruleSetRefs"
  ],
  "properties": {
    "contractVersion": { "const": "0.3" },
    "projectId": { "type": "string", "minLength": 1 },
    "facilityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string" },
        "revision": { "type": "string" }
      }
    },
    "baseVariantRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string" },
        "revision": { "type": "string" }
      }
    },
    "demandRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string" },
        "revision": { "type": "string" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["whole", "region"] },
        "polygon": { "type": "object", "additionalProperties": true },
        "boundaryPorts": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "locks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instanceId", "fields"],
        "properties": {
          "instanceId": { "type": "string" },
          "fields": {
            "oneOf": [
              { "const": "all" },
              { "type": "array", "items": { "type": "string" } }
            ]
          }
        }
      }
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "constraints": { "type": "object", "additionalProperties": true },
    "evaluationLevel": { "type": "string", "enum": ["quick", "detailed"] },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxConfigurations", "maxIterations", "maxWallTimeSec", "maxMemoryMb"],
      "properties": {
        "maxConfigurations": { "type": "integer", "exclusiveMinimum": 0 },
        "maxIterations": { "type": "integer", "exclusiveMinimum": 0 },
        "maxWallTimeSec": { "type": "number", "exclusiveMinimum": 0 },
        "maxMemoryMb": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "seed": { "type": "integer" },
    "catalogRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string" },
        "revision": { "type": "string" }
      }
    },
    "templateSetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string" },
        "revision": { "type": "string" }
      }
    },
    "ruleSetRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision"],
        "properties": {
          "id": { "type": "string" },
          "revision": { "type": "string" }
        }
      }
    },
    "costBasisRef": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string" },
        "revision": { "type": "string" }
      }
    },
    "priceBookRef": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string" },
        "revision": { "type": "string" }
      }
    },
    "scoreProfileRef": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string" },
        "revision": { "type": "string" }
      }
    }
  }
}
